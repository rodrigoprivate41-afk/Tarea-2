#include <stdio.h>

int main() {
    int radio;
    double area, circunferencia;
    const double PI = 3.1416;

    printf("Ingresa el radio del círculo: ");
    scanf("%d", &radio);

    area = PI * radio * radio;
    circunferencia = 2 * PI * radio;

    printf("\nÁrea: %.2f\n", area);
    printf("Circunferencia: %.2f\n", circunferencia);

    return 0;
}
